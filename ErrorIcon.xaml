<UserControl x:Class="Updater.ErrorIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Updater"
             mc:Ignorable="d" 
             d:DesignHeight="128" d:DesignWidth="128">
    <Grid>
        <Ellipse Width="102"
                 Height="102"
                 Canvas.Top="64"
                 Canvas.Left="64"
                 StrokeThickness="8"
                 Stroke="{StaticResource PathFillColor}"/>

        <Path Width="128"
              Height="128"
              Data="M 43,37 37,43 85,91 91,85 z"
              Fill="{StaticResource PathFillColor}"/>
        
        <Path Width="128"
              Height="128"
              Data="M 91,43 85,37 37,85 43,91 z"
              Fill="{StaticResource PathFillColor}"/>
    </Grid>
</UserControl>
