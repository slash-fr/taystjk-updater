<Window x:Class="Updater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Updater"
        mc:Ignorable="d"
        WindowStyle="None"
        ResizeMode="NoResize"
        Title="Launch TaystJK"
        Width="640"
        Height="360"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/background-image.jpg"/>
        </Grid.Background>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="200" />
            <RowDefinition Height="60" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <Path x:Name="LetterJ"
              Grid.Row="0"
              Width="256"
              Height="256"
              VerticalAlignment="Bottom"
              Fill="{StaticResource PathFillColor}"
              Data="m 120,33 -8,1 v 14 h -8 v 80 l -36,36 v 24 l 52,-52 z">
            <Path.LayoutTransform>
                <ScaleTransform ScaleX="0.5" ScaleY="0.5"/>
            </Path.LayoutTransform>
        </Path>
        <Path x:Name="LetterJSupport"
              Grid.Row="0"
              Width="256"
              Height="256"
              VerticalAlignment="Bottom"
              Fill="{StaticResource PathFillColor}"
              Data="m 120,154 -16,16 v 51 l 16,2">
            <Path.LayoutTransform>
                <ScaleTransform ScaleX="0.5" ScaleY="0.5"/>
            </Path.LayoutTransform>
        </Path>
        <Path x:Name="LetterK"
              Grid.Row="0"
              Width="256"
              Height="256"
              VerticalAlignment="Bottom"
              Fill="{StaticResource PathFillColor}"
              Data="m 136,33 0,190 16,-2 0,-79 40,40 v -24 l -40,-40 24,-24 V 72 L 152,96 V 48 H 144 V 34 Z">
            <Path.LayoutTransform>
                <ScaleTransform ScaleX="0.5" ScaleY="0.5"/>
            </Path.LayoutTransform>
        </Path>
        <Path x:Name="OpenCircle"
              Grid.Row="0"
              Width="256"
              Height="256"
              VerticalAlignment="Bottom"
              Stroke="{StaticResource PathFillColor}"
              StrokeThickness="16"
              Data="M 212.58,185.03 C 198.2,206.32 169.30,230 128,230 71.67,230 26,184.33 26,128 M 43.42,70.97 C 57.80,49.68 86.7,26 128,26 c 56.33,0 102,45.67 102,102">
            <Path.LayoutTransform>
                <ScaleTransform ScaleX="0.5" ScaleY="0.5"/>
            </Path.LayoutTransform>
            <Path.RenderTransform>
                <RotateTransform Angle="0" CenterX="64" CenterY="64"/>
            </Path.RenderTransform>
            <Path.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                From="0"
                                To="360"
                                Duration="00:00:01.5"
                                Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                RepeatBehavior="Forever"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Path.Triggers>
        </Path>
        <Path x:Name="LeftTriangle"
              Grid.Row="0"
              Width="256"
              Height="256"
              VerticalAlignment="Bottom"
              Fill="{StaticResource PathFillColor}"
              Data="m 26,84 -26,45 52,0 z">
            <Path.LayoutTransform>
                <ScaleTransform ScaleX="0.5" ScaleY="0.5"/>
            </Path.LayoutTransform>
            <Path.RenderTransform>
                <RotateTransform Angle="0" CenterX="64" CenterY="64"/>
            </Path.RenderTransform>
            <Path.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                From="0"
                                To="360"
                                Duration="00:00:01.5"
                                Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                RepeatBehavior="Forever"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Path.Triggers>
        </Path>
        <Path x:Name="RightTriangle"
              Grid.Row="0"
              Width="256"
              Height="256"
              VerticalAlignment="Bottom"
              Fill="{StaticResource PathFillColor}"
              Data="m 256,127 -52,0 26,45 z">
            <Path.LayoutTransform>
                <ScaleTransform ScaleX="0.5" ScaleY="0.5"/>
            </Path.LayoutTransform>
            <Path.RenderTransform>
                <RotateTransform Angle="0" CenterX="64" CenterY="64"/>
            </Path.RenderTransform>
            <Path.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                From="0"
                                To="360"
                                Duration="00:00:01.5"
                                Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                RepeatBehavior="Forever"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Path.Triggers>
        </Path>

        <Label Content="Checking for updates…"
               Grid.Row="1"
               HorizontalAlignment="Center"
               HorizontalContentAlignment="Center"
               VerticalContentAlignment="Center"
               FontSize="20"
               Foreground="White">
        </Label>

        <Button Content="Skip"
                Grid.Row="2"
                Width="60"
                Height="30"
                Style="{StaticResource DefaultButtonStyle}">
        </Button>
    </Grid>
</Window>
